APP_NAME="Aircraft Pilot Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
MAIL_MAILER=log
IP_WHITELIST_ENABLED=false

# Set these before first full database seed. If empty, the seeder prints a one-time generated password.
AVIATION_ADMIN_PASSWORD=
AVIATION_MANAGER_PASSWORD=
